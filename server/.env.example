# 백엔드(Express) 환경변수 — 이 파일의 값은 서버에서만 사용되며 클라이언트에 노출되지 않는다.

PORT=4000
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-random-string

# GitHub OAuth App (https://github.com/settings/developers 에서 생성)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# PostgreSQL (Supabase 프로젝트 Settings → Database → Connection string 에서 확인)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wagbfziuoxbtmvcnibsf.supabase.co:5432/postgres

# Vercel Personal Access Token 암호화 키 — base64로 인코딩된 32바이트 랜덤 값.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key
